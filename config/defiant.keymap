#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "keys_de.h"


/ {
    behaviors {
        de_q: de_q {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_Q>, <&kp DE_AT>; // Q, @
            mods = <(MOD_RALT)>;
        };

        de_e: de_e {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_E>, <&kp DE_EURO>; // E, €
            mods = <(MOD_RALT)>;
        };

        de_a: de_a {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_A>, <&kp DE_A_UMLAUT>; // A, ä
            mods = <(MOD_RALT)>;
        };

        de_o: de_o {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_O>, <&kp DE_O_UMLAUT>; // O, ö
            mods = <(MOD_RALT)>;
        };

        de_u: de_u {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_U>, <&kp DE_U_UMLAUT>; // U, ü
            mods = <(MOD_RALT)>;
        };

        de_s: de_s {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_S>, <&kp DE_SZ>; // S, ß
            mods = <(MOD_RALT)>;
        };

        de_p: de_p {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_P>, <&kp DE_POUND>; // S, ß
            mods = <(MOD_RALT)>;
        };

        de_m: de_m {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_M>, <&kp DE_MU>; // M, µ
            mods = <(MOD_RALT)>;
        };

    };

    combos {
        compatible = "zmk,combos";

        reset_right {
            bindings = <&bootloader>;
            key-positions = <16 28 43>;
        };

        reset_left {
            bindings = <&bootloader>;
            key-positions = <15 27 34>;
        };
    };

macros {
    code_block: code_block {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&kp DE_ACUTE &kp DE_ACUTE &kp DE_ACUTE>;
    };
};

keymap {
    compatible = "zmk,keymap";

    default_layer {
        bindings = <
&de_q      &kp DE_W &de_e    &kp DE_R      &kp DE_T                                      &kp DE_Z    &de_u    &kp DE_I      &de_o      &de_p
&de_a      &de_s    &kp DE_D &kp DE_F      &kp DE_G    &mo 2             &mo 1           &kp DE_H    &kp DE_J &kp DE_K      &kp DE_L   &kp DE_SEMI
&kp DE_Y   &kp DE_X &kp DE_C &kp DE_V      &kp DE_B    &kp LGUI          &kp RCTRL       &kp DE_N    &kp DE_M &kp DE_COMMA  &kp DE_DOT &kp DE_FSLH
&kp LCTRL  &kp DEL  &kp TAB  &kp SPACE     &kp LSHIFT                                    &kp RSHIFT  &kp RET  &kp BSPC      &kp ESC    &kp RALT
        >;
    };

second {
    bindings = <
&kp DE_N1    &kp DE_N2    &kp DE_N3    &kp DE_N4    &kp DE_N5                      &kp DE_N6   &kp DE_N7   &kp DE_N8   &kp DE_N9    &kp DE_N0
&kp DE_PLUS  &kp DE_MINUS &kp DE_ASTRK &kp DE_CARET &kp DE_DEG   &trans   &trans   &kp DE_LBRC &kp DE_RBRC &kp DE_LT   &kp DE_GT    &kp DE_SQT
&kp DE_TILDE &kp DE_GRAVE &kp DE_AMPS  &kp DE_EQUAL &kp DE_UNDER &trans   &trans   &kp DE_LBKT &kp DE_RBKT &kp DE_SEMI &kp DE_COLON &kp DE_BSLH
&trans       &trans       &trans       &trans       &trans                         &trans      &trans      &trans      &trans       &trans
    >;
};

    function {
        bindings = <
&kp F1       &kp F2        &kp F3       &kp F4        &kp F5                          &kp F6      &kp F7     &kp F8     &kp F9     &kp F10
&kp F11      &kp F12       &code_block  &kp DE_HASH   &bt BT_CLR &trans    &trans     &none       &none      &kp UP     &none      &none
&bt BT_SEL 0 &bt BT_DISC 0 &bt BT_SEL 1 &bt BT_DISC 1 &none      &trans    &trans     &kp HOME    &kp LEFT   &kp DOWN   &kp RIGHT  &kp END
&trans       &trans        &trans       &trans        &trans                          &trans      &trans     &trans     &trans     &trans
        >;
    };
};
};
